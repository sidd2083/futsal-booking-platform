# ==========================================
# FUTSAL BOOKING PLATFORM - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env.local for local development.
# For Vercel production deployment, set these variables in your Vercel Project Settings.

# Firebase Web App Configuration
# Obtain these from your Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Business Configuration Defaults (Fallback if not configured in Firestore)
VITE_DEFAULT_PRICE_NORMAL_DAY=1300
VITE_DEFAULT_PRICE_SATURDAY=1500
VITE_CURRENCY=NPR
VITE_OPERATING_HOURS_START=6
VITE_OPERATING_HOURS_END=22

# Admin Contact & Support (Display placeholders until verified)
VITE_BUSINESS_PHONE=+977-98XXXXXXXX
VITE_BUSINESS_LOCATION=Kathmandu, Nepal
