rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins registry collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin']));
      allow delete: if isAdmin();
    }

    // Public business settings (pricing, court count, operating hours)
    match /settings/{settingId} {
      allow read: if true; // Publicly readable for dynamic pricing & schedule
      allow write: if isAdmin();
    }

    // Public court slot availability (locks to prevent double booking)
    // Document ID structure: {sport}_{courtId}_{YYYY-MM-DD}_{HH}
    match /slots/{slotId} {
      allow read: if true; // Anyone can check whether a slot is free, pending, or booked
      // Users can reserve an open slot as pending; Admin can fully manage
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.status == 'pending' &&
          request.resource.data.userId == request.auth.uid
        )
      );
      allow update: if isAdmin() || (
        // User can update only their own pending slot before approval/expiration
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending'
      );
      allow delete: if isAdmin();
    }

    // Booking orders
    match /bookings/{bookingId} {
      // Customers can only view their own bookings; Admins view all
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      // Authenticated users can submit a pending booking request
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.paymentMethod == 'pay_on_arrival'
        )
      );

      // Only administrators can approve, reject, or mark payment received
      allow update: if isAdmin();

      // Only administrators can delete or archive bookings
      allow delete: if isAdmin();
    }

    // Audit logs for administrative actions
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
