rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email))) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)))
      );
    }

    // Authorized Admin Registries (Lookup by UID or Email)
    match /adminUsers/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Phone number registry to prevent duplicate phone registration across accounts
    match /phoneRegistry/{phone} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Public business settings (pricing, court count, operating hours)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Public court slot availability (locks to prevent double booking)
    // Document ID structure: {sport}_{courtId}_{YYYY-MM-DD}_{HH}
    match /slots/{slotId} {
      allow read: if true; // Publicly readable for real-time slot colors
      allow create, update, delete: if isAuthenticated();
    }

    // Booking orders
    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Audit logs for administrative actions
    match /audit_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAuthenticated();
    }
  }
}
