rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email))) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)))
      );
    }

    // Authorized Admin Registries (Lookup by UID or Email)
    match /adminUsers/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Phone number registry to prevent duplicate phone registration across accounts
    match /phoneRegistry/{phone} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin']));
      allow delete: if isAdmin();
    }

    // Public business settings (pricing, court count, operating hours)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public court slot availability (locks to prevent double booking)
    // Document ID structure: {sport}_{courtId}_{YYYY-MM-DD}_{HH}
    match /slots/{slotId} {
      allow read: if true; // Publicly readable for real-time slot colors
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.status == 'pending' &&
          request.resource.data.userId == request.auth.uid
        )
      );
      allow update: if isAdmin() || (
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending'
      );
      allow delete: if isAdmin();
    }

    // Booking orders
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          (request.resource.data.paymentMethod in ['pay_on_arrival', 'pay_online', 'esewa', 'khalti'])
        )
      );

      // Only administrators can approve, reject, or mark payment received
      allow update: if isAdmin();

      // Only administrators can delete or archive bookings
      allow delete: if isAdmin();
    }

    // Audit logs for administrative actions
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
