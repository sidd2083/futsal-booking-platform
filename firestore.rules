rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // ─── PUBLIC COLLECTIONS (Guest Accessible) ──────────────────────────────
    // 1. Court Slots: Publicly readable so visitors see real-time availability.
    // Authenticated users (customers & admins) can create, lock, and update slots.
    match /slots/{slotId} {
      allow read:                   if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 2. Phone Registry: Prevents duplicate phone registration across player accounts.
    // Must be readable and writable during registration before the session is created.
    match /phoneRegistry/{phone} {
      allow read, write: if true;
    }

    // 3. Business Settings: Publicly readable pricing & opening hours.
    match /settings/{settingId} {
      allow read:  if true;
      allow write: if isAuthenticated();
    }

    // ─── APPLICATION ENTITIES ───────────────────────────────────────────────
    // Bookings: Publicly readable so all visitors (guest or authenticated)
    // immediately see live booked/pending court availability in real-time.
    // Writes (create, update, delete) require authenticated user or venue staff.
    match /bookings/{bookingId} {
      allow read:  if true;
      allow write: if isAuthenticated();
    }

    // User Profiles:
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Admin registries:
    match /adminUsers/{adminId} {
      allow read, write: if isAuthenticated();
    }

    match /admins/{adminId} {
      allow read, write: if isAuthenticated();
    }

    match /admin/{adminId} {
      allow read, write: if isAuthenticated();
    }

    // Audit logs:
    match /audit_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Fallback: any other collection
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
